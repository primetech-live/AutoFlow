{
  "name": "autoflow-tech",
  "version": "1.1.1",
  "description": "Automated CI/CD CLI tool for students and beginners",
  "main": "dist/src/main/index.js",
  "bin": {
    "autoflow": "./dist/bin/index.js"
  },
  "scripts": {
    "build:cli": "vite build -c vite.cli.config.ts",
    "build": "npm run build:cli && npm run build:ui && tsc && node scripts/copy-assets.js",
    "build:ui": "vite build",
    "start": "electron .",
    "dev:ui": "vite",
    "dev:cli": "ts-node bin/index.ts",
    "pack": "npm run build && electron-builder --dir",
    "dist": "npm run build && electron-builder",
    "postinstall": "node scripts/postinstall.js",
    "prepublishOnly": "npm run build",
    "test": "jest"
  },
  "build": {
    "appId": "com.autoflow.vnext",
    "productName": "Autoflow-vNext",
    "publish": [
      {
        "provider": "github",
        "owner": "Sanji1305",
        "repo": "AutoFlow"
      }
    ],
    "directories": {
      "output": "release"
    },
    "files": [
      "dist",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon-1.png"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "license": "build/license.txt",
      "uninstallDisplayName": "Autoflow-vNext",
      "installerSidebar": "build/installer-sidebar.bmp",
      "uninstallerSidebar": "build/installer-sidebar.bmp"
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false
    },
    "dmg": {
      "sign": false
    }
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "cli",
    "deployment",
    "automation",
    "devops",
    "docker",
    "ssh",
    "cicd"
  ],
  "author": "PrimeTech",
  "license": "MIT",
  "files": [
    "bin",
    "dist",
    "scripts"
  ],
  "dependencies": {
    "@supabase/supabase-js": "^2.110.0",
    "chalk": "^4.1.2",
    "commander": "^14.0.2",
    "electron-updater": "^6.8.9",
    "figlet": "^1.9.4",
    "inquirer": "^8.2.5",
    "izitoast": "^1.4.0",
    "node-ssh": "^13.2.1",
    "qrcode-terminal": "^0.12.0",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "shelljs": "^0.10.0",
    "simple-git": "^3.30.0",
    "speakeasy": "^2.0.0",
    "ws": "^8.21.0",
    "xterm": "^5.3.0",
    "xterm-addon-fit": "^0.8.0"
  },
  "devDependencies": {
    "@types/figlet": "^1.7.0",
    "@types/inquirer": "^8.2.10",
    "@types/jest": "^30.0.0",
    "@types/node": "^22.0.0",
    "@types/qrcode-terminal": "^0.12.2",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.1",
    "@types/shelljs": "^0.8.15",
    "@types/speakeasy": "^2.0.10",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^28.2.0",
    "electron-builder": "^24.9.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "vite": "^5.3.1"
  }
}
